% ============================================================================
% CSOK 2x — Full governance, conflict error active (verification benchmark)
% ============================================================================
% Expected result: UNSAT
% (IncomeCred and SecondaryIncomeCred have no valid format under joint
% eIDAS + GDPR governance — same conflict as 1x, doubled)

import vc_metamodel.
import governance_conflict.
import csok_instance_2x.


% === Governance markers ===

% eIDAS mandate: all six credentials are EU wallet attestations
EidasMandate(eidas_1).
EidasMandate::target(eidas_1, FamilyStatusCred).
EidasMandate(eidas_2).
EidasMandate::target(eidas_2, PropertyCred).
EidasMandate(eidas_3).
EidasMandate::target(eidas_3, IncomeCred).
EidasMandate(eidas_4).
EidasMandate::target(eidas_4, DependentStatusCred).
EidasMandate(eidas_5).
EidasMandate::target(eidas_5, VehicleCred).
EidasMandate(eidas_6).
EidasMandate::target(eidas_6, SecondaryIncomeCred).

% Privacy requirement: both income credentials need predicate proofs
PrivacyRequirement(privacy_1).
PrivacyRequirement::target(privacy_1, IncomeCred).
PrivacyRequirement(privacy_2).
PrivacyRequirement::target(privacy_2, SecondaryIncomeCred).

% VCDM conformance: all credentials must conform to W3C data model
VcdmConformance(vcdm_1).
VcdmConformance::target(vcdm_1, FamilyStatusCred).
VcdmConformance(vcdm_2).
VcdmConformance::target(vcdm_2, PropertyCred).
VcdmConformance(vcdm_3).
VcdmConformance::target(vcdm_3, IncomeCred).
VcdmConformance(vcdm_4).
VcdmConformance::target(vcdm_4, DependentStatusCred).
VcdmConformance(vcdm_5).
VcdmConformance::target(vcdm_5, VehicleCred).
VcdmConformance(vcdm_6).
VcdmConformance::target(vcdm_6, SecondaryIncomeCred).

% Close governance
!exists(EidasMandate::new).
!exists(PrivacyRequirement::new).
!exists(VcdmConformance::new).

scope node = 57, GovernanceAnnotation = 14.
