% ============================================================================
% CSOK Instance 3x — Full Financial Profile (3x scale)
% ============================================================================
% Original CSOK instance (set A) plus set B (dependents, vehicle, secondary
% income) and set C (education, savings, pension). Single-subject expansion.
% Governance markers and scope are in the entry-point .problem files.

import vc_metamodel.


% === Node declarations ===

% DCL nodes — Set A (original)
declare Applicant, has_children, owns_property, earns.
declare num_children, property_area, monthly_income.

% DCL nodes — Set B (extended)
declare has_dependents, owns_vehicle, earns_secondary.
declare num_dependents, vehicle_value, secondary_income.

% DCL nodes — Set C (additional)
declare has_education, owns_savings, earns_pension.
declare education_level, savings_amount, pension_income.

% CSL nodes — Set A
declare CS_Applicant_1, CS_Applicant_2, CS_Applicant_3.
declare has_children_claim, owns_property_claim, earns_claim.
declare num_children_1, property_area_1, monthly_income_1.
declare FamilyStatusCred, PropertyCred, IncomeCred.

% CSL nodes — Set B
declare CS_Applicant_4, CS_Applicant_5, CS_Applicant_6.
declare has_dependents_claim, owns_vehicle_claim, earns_secondary_claim.
declare num_dependents_1, vehicle_value_1, secondary_income_1.
declare DependentStatusCred, VehicleCred, SecondaryIncomeCred.

% CSL nodes — Set C
declare CS_Applicant_7, CS_Applicant_8, CS_Applicant_9.
declare has_education_claim, owns_savings_claim, earns_pension_claim.
declare education_level_1, savings_amount_1, pension_income_1.
declare EducationCred, SavingsCred, PensionIncomeCred.

% FSL nodes
declare sd_jwt_family, sd_jwt_property, income_format.
declare sd_jwt_dependent, sd_jwt_vehicle, secondary_income_format.
declare sd_jwt_education, sd_jwt_savings, pension_income_format.


% === DCL: domain facts ===

Subject(Applicant).

% Set A values
Value(num_children).
Value(property_area).
Value(monthly_income).

% Set B values
Value(num_dependents).
Value(vehicle_value).
Value(secondary_income).

% Set C values
Value(education_level).
Value(savings_amount).
Value(pension_income).

% Set A properties
Prop(has_children).
Prop(owns_property).
Prop(earns).
property(Applicant, has_children).
property(Applicant, owns_property).
property(Applicant, earns).
value(has_children, num_children).
value(owns_property, property_area).
value(earns, monthly_income).

% Set B properties
Prop(has_dependents).
Prop(owns_vehicle).
Prop(earns_secondary).
property(Applicant, has_dependents).
property(Applicant, owns_vehicle).
property(Applicant, earns_secondary).
value(has_dependents, num_dependents).
value(owns_vehicle, vehicle_value).
value(earns_secondary, secondary_income).

% Set C properties
Prop(has_education).
Prop(owns_savings).
Prop(earns_pension).
property(Applicant, has_education).
property(Applicant, owns_savings).
property(Applicant, earns_pension).
value(has_education, education_level).
value(owns_savings, savings_amount).
value(earns_pension, pension_income).

% Close DCL
!exists(Subject::new).
!exists(Value::new).
!exists(Prop::new).


% === CSL: credential decomposition (fixed — not explored) ===

% Set A types
CredentialSubject(CS_Applicant_1).
CredentialSubject(CS_Applicant_2).
CredentialSubject(CS_Applicant_3).
CredentialValue(num_children_1).
CredentialValue(property_area_1).
CredentialValue(monthly_income_1).
Claim(has_children_claim).
Claim(owns_property_claim).
Claim(earns_claim).
Credential(FamilyStatusCred).
Credential(PropertyCred).
Credential(IncomeCred).

% Set B types
CredentialSubject(CS_Applicant_4).
CredentialSubject(CS_Applicant_5).
CredentialSubject(CS_Applicant_6).
CredentialValue(num_dependents_1).
CredentialValue(vehicle_value_1).
CredentialValue(secondary_income_1).
Claim(has_dependents_claim).
Claim(owns_vehicle_claim).
Claim(earns_secondary_claim).
Credential(DependentStatusCred).
Credential(VehicleCred).
Credential(SecondaryIncomeCred).

% Set C types
CredentialSubject(CS_Applicant_7).
CredentialSubject(CS_Applicant_8).
CredentialSubject(CS_Applicant_9).
CredentialValue(education_level_1).
CredentialValue(savings_amount_1).
CredentialValue(pension_income_1).
Claim(has_education_claim).
Claim(owns_savings_claim).
Claim(earns_pension_claim).
Credential(EducationCred).
Credential(SavingsCred).
Credential(PensionIncomeCred).

% Set A trace mappings: each Prop traces to a Claim
Prop::trace(has_children, has_children_claim).
Prop::trace(owns_property, owns_property_claim).
Prop::trace(earns, earns_claim).

% Set B trace mappings
Prop::trace(has_dependents, has_dependents_claim).
Prop::trace(owns_vehicle, owns_vehicle_claim).
Prop::trace(earns_secondary, earns_secondary_claim).

% Set C trace mappings
Prop::trace(has_education, has_education_claim).
Prop::trace(owns_savings, owns_savings_claim).
Prop::trace(earns_pension, earns_pension_claim).

% Set A claims: source and target
Claim::source(has_children_claim, CS_Applicant_1).
Claim::target(has_children_claim, num_children_1).
Claim::source(owns_property_claim, CS_Applicant_2).
Claim::target(owns_property_claim, property_area_1).
Claim::source(earns_claim, CS_Applicant_3).
Claim::target(earns_claim, monthly_income_1).

% Set B claims: source and target
Claim::source(has_dependents_claim, CS_Applicant_4).
Claim::target(has_dependents_claim, num_dependents_1).
Claim::source(owns_vehicle_claim, CS_Applicant_5).
Claim::target(owns_vehicle_claim, vehicle_value_1).
Claim::source(earns_secondary_claim, CS_Applicant_6).
Claim::target(earns_secondary_claim, secondary_income_1).

% Set C claims: source and target
Claim::source(has_education_claim, CS_Applicant_7).
Claim::target(has_education_claim, education_level_1).
Claim::source(owns_savings_claim, CS_Applicant_8).
Claim::target(owns_savings_claim, savings_amount_1).
Claim::source(earns_pension_claim, CS_Applicant_9).
Claim::target(earns_pension_claim, pension_income_1).

% Set A credential structure
_(CS_Applicant_1, FamilyStatusCred).
_(CS_Applicant_2, PropertyCred).
_(CS_Applicant_3, IncomeCred).

% Set B credential structure
_(CS_Applicant_4, DependentStatusCred).
_(CS_Applicant_5, VehicleCred).
_(CS_Applicant_6, SecondaryIncomeCred).

% Set C credential structure
_(CS_Applicant_7, EducationCred).
_(CS_Applicant_8, SavingsCred).
_(CS_Applicant_9, PensionIncomeCred).

% All credential subjects trace to Applicant
CredEntity::trace(CS_Applicant_1, Applicant).
CredEntity::trace(CS_Applicant_2, Applicant).
CredEntity::trace(CS_Applicant_3, Applicant).
CredEntity::trace(CS_Applicant_4, Applicant).
CredEntity::trace(CS_Applicant_5, Applicant).
CredEntity::trace(CS_Applicant_6, Applicant).
CredEntity::trace(CS_Applicant_7, Applicant).
CredEntity::trace(CS_Applicant_8, Applicant).
CredEntity::trace(CS_Applicant_9, Applicant).

% Set A value traces
CredEntity::trace(num_children_1, num_children).
CredEntity::trace(property_area_1, property_area).
CredEntity::trace(monthly_income_1, monthly_income).

% Set B value traces
CredEntity::trace(num_dependents_1, num_dependents).
CredEntity::trace(vehicle_value_1, vehicle_value).
CredEntity::trace(secondary_income_1, secondary_income).

% Set C value traces
CredEntity::trace(education_level_1, education_level).
CredEntity::trace(savings_amount_1, savings_amount).
CredEntity::trace(pension_income_1, pension_income).

% Close CSL
!exists(CredentialSubject::new).
!exists(CredentialValue::new).
!exists(Claim::new).
!exists(Credential::new).
default !CredEntity::trace(*, *).


% === FSL: format assignments ===

% Set A: FamilyStatusCred and PropertyCred fixed, IncomeCred open
SdJwtVcSchema(sd_jwt_family).
format(FamilyStatusCred, sd_jwt_family).
SdJwtVcSchema(sd_jwt_property).
format(PropertyCred, sd_jwt_property).
Formatted_Credential(income_format).
format(IncomeCred, income_format).

% Set B: DependentStatusCred and VehicleCred fixed, SecondaryIncomeCred open
SdJwtVcSchema(sd_jwt_dependent).
format(DependentStatusCred, sd_jwt_dependent).
SdJwtVcSchema(sd_jwt_vehicle).
format(VehicleCred, sd_jwt_vehicle).
Formatted_Credential(secondary_income_format).
format(SecondaryIncomeCred, secondary_income_format).

% Set C: EducationCred and SavingsCred fixed, PensionIncomeCred open
SdJwtVcSchema(sd_jwt_education).
format(EducationCred, sd_jwt_education).
SdJwtVcSchema(sd_jwt_savings).
format(SavingsCred, sd_jwt_savings).
Formatted_Credential(pension_income_format).
format(PensionIncomeCred, pension_income_format).

% Close FSL (income_format, secondary_income_format, pension_income_format open)
!exists(AnoncredsCredentialSchema::new).
!exists(JsonLdCredentialSchema::new).
!exists(JwtVCCredentialSchema::new).
!exists(SdJwtVcSchema::new).
!exists(MdocSchema::new).
