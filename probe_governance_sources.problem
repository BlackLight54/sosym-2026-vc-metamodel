% ============================================================================
% Probe: do the per-source C5/C6/C7 rules fire, and do they reach an instance
% through the same import line the G0-G7 battery uses?
% ============================================================================
% One credential under an eIDAS format mandate AND a privacy requirement, with
% its format class left open. C5 admits {SdJwtVcSchema, MdocSchema}, C6 admits
% {AnoncredsCredentialSchema}; the intersection is empty, so this must be UNSAT.
% Control: probe_governance_sources_control.problem (eIDAS mandate only) -> SAT.
%
% Imports are deliberately identical to evaluation/instances/sensitivity_G*.problem
% (vc_metamodel + governance_conflict, nothing else): a SAT verdict here would
% mean governance_sources is not reachable through governance_conflict's import
% and the whole battery would be measuring nothing.

import vc_metamodel.
import governance_conflict.


% === DCL ===
declare Applicant, prop_1, val_1.
Subject(Applicant).
Prop(prop_1).
Value(val_1).
property(Applicant, prop_1).
value(prop_1, val_1).
!exists(Subject::new).
!exists(Value::new).
!exists(Prop::new).


% === CSL ===
declare cs_1, claim_1, cv_1, cred_1.
CredentialSubject(cs_1).
Claim(claim_1).
CredentialValue(cv_1).
Credential(cred_1).
Prop::trace(prop_1, claim_1).
Claim::source(claim_1, cs_1).
Claim::target(claim_1, cv_1).
_(cs_1, cred_1).
CredEntity::trace(cs_1, Applicant).
CredEntity::trace(cv_1, val_1).
!exists(CredentialSubject::new).
!exists(CredentialValue::new).
!exists(Claim::new).
!exists(Credential::new).
default !CredEntity::trace(*, *).


% === FSL: format class left open for the solver ===
declare fmt_1.
Formatted_Credential(fmt_1).
format(cred_1, fmt_1).
!exists(AnoncredsCredentialSchema::new).
!exists(JsonLdCredentialSchema::new).
!exists(JwtVCCredentialSchema::new).
!exists(SdJwtVcSchema::new).
!exists(MdocSchema::new).


% === Governance: eIDAS + privacy, no VCDM conformance ===
EidasMandate(eidas_1).
EidasMandate::target(eidas_1, cred_1).
PrivacyRequirement(privacy_1).
PrivacyRequirement::target(privacy_1, cred_1).
!exists(EidasMandate::new).
!exists(PrivacyRequirement::new).
!exists(VcdmConformance::new).

scope node = 8, GovernanceAnnotation = 2.
