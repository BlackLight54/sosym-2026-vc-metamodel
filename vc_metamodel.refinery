% ============================================================================
% VC Ecosystem Metamodel — Three-Layer Partial Graph Specification
% ============================================================================
% Three-layer metamodel for verifiable credential ecosystem design.
%
% Layers:
%   DCL — Domain Concept Layer (domain-level information graph)
%   CSL — Credential Schema Layer (abstract credential schemas)
%   FSL — Format-Specific Layer (format classes, capabilities, governance)
%
% Changes from prior model:
%   - Credential.format: single abstract containment [1] (was per-format [1]x3)
%   - New format classes: SdJwtVcSchema, MdocSchema
%   - Format capability predicates (derived from class membership)
%   - Format capability propagation rules (narrow format design space)
%   - GovernanceAnnotation marker classes (generic governance encoding)
% ============================================================================


% =============================================
% DCL — Domain Concept Layer (domain-level information graph)
% =============================================

shadow pred DCL(e) <-> Entity(e); Prop(e).

abstract class Entity {
    contains Prop[] property
}

class Subject extends Entity {
}

propagation rule root_is_subj(Entity e) <->
    must !value(_, e)
    ==>
    Subject(e).

class Value extends Entity {
}

pred Leaf(Value e) <-> !property(e, _).

class Prop {
    contains Value[1] value
    contains Claim[1] trace
}

pred statement(Entity subject, Prop property, Entity value) <->
    subject != value,
    property(subject, property),
    value(property, value).

propagation rule statement_rule(Entity subject, Prop property, Entity value) <->
    must statement(subject, property, value)
==>
    Value(value),
    property(subject, property),
    value(property, value).

propagation rule statement_rule_bw(Entity subject, Prop property, Entity value) <->
    must property(subject, property), must value(property, value)
==>
    Value(value),
    statement(subject, property, value).

pred neighbours(Entity s, Entity t) <-> statement(s, _, t); statement(t, _, s).

error non_connected(Entity n, Entity m) <-> n != m, !neighbours+(n, m).

propagation rule no_self_loop(Prop p, Entity e) <->
    must property(e, p) ==> !value(p, e).

pred directed_edge(Entity s, Entity t) <-> statement(s, _, t).

error cyclic(Entity e) <-> directed_edge+(e, e).
% Prohibits cycles in the DCL information graph via transitive closure of directed edges.


% --- C4: cross-credential value dependency (uninterpreted domain rule) ---
% depends_on(p1, p2) records that a domain rule constrains the value of p1
% using the value of p2. The relation is UNINTERPRETED: it has no body, so its
% extension is instance data asserted by the ecosystem designer, never derived.
% The metamodel records THAT a rule relates two properties and in which
% direction; it does not represent the rule's predicate, its arithmetic, or its
% satisfaction. Nothing here claims the model understands, for example, the CSOK
% floor-area rule property_area >= min_area(num_children); it claims only that
% owns_property is subject to a rule reading has_children.
%
% Scope of the encoding, so it is not read as more: depends_on prunes nothing
% and flags nothing on its own. Its single consumer is domain_dependency_gap
% below, which uses it to separate the credential pair a domain rule actually
% spans from the pairs that are merely subject-aligned.
% Unasserted pairs are false, not unknown (solver-verified 2026-08-05), so no
% closure statement is required in instance files.
pred depends_on(Prop p1, Prop p2).


% =============================================
% CSL — Credential Schema Layer (abstract credential schemas)
% =============================================

shadow pred CSL(e) <-> CredEntity(e); Claim(e); Credential(e).

abstract class CredEntity {
    Entity[1] trace
}

class CredentialSubject extends CredEntity {
    contains Credential[0..1] _ opposite credentialSubject
}

propagation rule subject_traces_to_subject(CredEntity t) <->
    must Subject(e), must CredEntity::trace(t, e)
==>
    CredentialSubject(t).

class CredentialValue extends CredEntity {
}

class Claim {
    contains CredEntity[1] source
    contains CredentialValue[1] target
}

pred cred_neighbors(CredEntity s, CredEntity t) <->
    credential_statement(s, _, t); credential_statement(t, _, s).

propagation rule root_is_cred_subj(CredEntity cs) <->
    may CredentialSubject(cs), must !Claim::target(_, cs)
==>
    CredentialSubject(cs).

error no_empty_cred(CredentialSubject cs) <-> !source(_, cs).

pred credential_statement(CredEntity source, Claim prop, CredEntity target) <->
    source != target,
    Claim::source(prop, source),
    Claim::target(prop, target),
    CredentialValue(target).

propagation rule credential_statement_rule(CredEntity source, Claim prop, CredEntity target) <->
    must credential_statement(source, prop, target)
==>
    Claim::source(prop, source),
    Claim::target(prop, target),
    CredentialValue(target).

propagation rule credential_statement_rule_opp(CredEntity source, Claim prop, CredEntity target) <->
    must Claim::source(prop, source), must Claim::target(prop, target)
==>
    credential_statement(source, prop, target),
    CredentialValue(target).

% Root credential entity: not targeted by any credential statement
pred Root_cred_entity(CredEntity e) <->
    !credential_statement(_, _, e).

propagation rule targets_are_not_roots(CredEntity e) <->
    must Claim::target(_, e)
==>
    !Root_cred_entity(e).

propagation rule cred_points_to_root_cred_e(CredEntity e, Credential c) <->
    must !Root_cred_entity(e)
==>
    !credentialSubject(c, e).

error root_ent_doesnt_have_cred(Root_cred_entity e) <->
    !credentialSubject(_, e).

% Cross-layer trace consistency: forbid misaligned claim targets
propagation rule prop_t(Claim c, CredEntity t) <->
    must Prop::trace(p, c),
    must Prop::value(p, e),
    must !CredEntity::trace(t, e),
    may Claim::target(c, t)
==>
    !Claim::target(c, t).

% Cross-layer trace consistency: forbid misaligned claim sources
propagation rule prop_s(Claim c, CredEntity s) <->
    must Prop::trace(p, c),
    must Entity::property(e, p),
    must !CredEntity::trace(s, e),
    may Claim::source(c, s)
==>
    !Claim::source(c, s).

% Entity alignment: two CredEntities tracing to the same Entity
shadow pred aligned(CredEntity c_e1, CredEntity c_e2) <->
    CredEntity::trace(c_e1, e),
    CredEntity::trace(c_e2, e),
    c_e1 != c_e2.

% Credential class — evolved: single abstract format containment
class Credential {
    container CredentialSubject credentialSubject opposite _
    contains Formatted_Credential[1] format
}

% The shadow predicate common_parent (two Props sharing a credential subject)
% was retired on 2026-08-03 (decision DEC-common_parent_retired): it was solver-confirmed vacuous.
% Prop::trace and Claim::source are both containments, so distinct Props force
% distinct Claims force distinct source CredEntities and e1 == e2 can never
% hold. Vacuity evidence: probe_common_parent.problem (UNSAT under generate)
% against probe_common_parent_control.problem (SAT).

% =============================================
% FSL — Format-Specific Layer
% =============================================

shadow pred FSL(e) <-> Formatted_Credential(e); GovernanceAnnotation(e).

abstract class Formatted_Credential {
}

class AnoncredsCredentialSchema extends Formatted_Credential.
class JsonLdCredentialSchema extends Formatted_Credential.
class JwtVCCredentialSchema extends Formatted_Credential.
class SdJwtVcSchema extends Formatted_Credential.
class MdocSchema extends Formatted_Credential.


% --- Format capability predicates (derived from class membership) ---

% Predicate proof support: only AnonCreds (CL signatures)
pred supports_predicate_proof(Formatted_Credential f) <->
    AnoncredsCredentialSchema(f).

% Selective disclosure: SD-JWT-VC (hash-based), JSON-LD (BBS+), AnonCreds, mdoc
pred supports_selective_disclosure(Formatted_Credential f) <->
    SdJwtVcSchema(f);
    JsonLdCredentialSchema(f);
    AnoncredsCredentialSchema(f);
    MdocSchema(f).

% W3C VCDM 2.0 conformance: all except AnonCreds v1 and mdoc
% mdoc (ISO 18013-5) uses CBOR/COSE, not the JSON-LD/JSON data model of VCDM 2.0.
pred conforms_vcdm(Formatted_Credential f) <->
    SdJwtVcSchema(f);
    JsonLdCredentialSchema(f);
    JwtVCCredentialSchema(f).

% ZKP support (co-occurs with predicate_proofs)
pred supports_zkp(Formatted_Credential f) <->
    AnoncredsCredentialSchema(f).

% Offline/proximity verification capability (ISO 18013-5 NFC transfer)
pred supports_offline_verification(Formatted_Credential f) <->
    MdocSchema(f).

% Multi-credential proof support: no deployed format supports evaluating
% predicates over values from distinct credentials in a single proof.
% AnonCreds link secrets allow linking proofs but not cross-credential arithmetic.
%
% STIPULATED, NOT DERIVED. Every other capability predicate in this block is a
% disjunction over format classes, so its extension follows from the class
% assignment the solver chooses. This one is `f != f`: unsatisfiable by
% construction, an empty row of the capability matrix hardcoded as a
% compile-time constant. It is a closed-world fact read off the format
% specifications as of the snapshot (ARF v2.9.0, SD-JWT VC, ISO/IEC 18013-5,
% AnonCreds v1, W3C VCDM 2.0), not a consequence of anything the model
% computes. Deliberate and load-bearing for Headline 2: the point of the row is
% that the capability is absent across the whole format space, and a five-way
% empty disjunction would state the same thing less legibly.
%
% What this costs, stated so it is not discovered: the format conjunct of
% cross_cred_predicate_gap is constant, so C9's extension does not depend on the
% format the solver assigns, and adding a sixth format class would not change
% the predicate unless this line were edited. The claim is falsifiable exactly
% here, in one line, by a format that acquires the capability.
% Do not "repair" this to a class disjunction; that would assert a positive
% capability the snapshot does not support. The A-notes carrying the
% stipulation are ART-vc_metamodel_refinery (declaration) and ART-anti_pattern_true_positives (C9 witness record).
pred supports_multi_credential_proof(Formatted_Credential f) <->
    f != f.


% --- Format capability propagation rules ---
% Source: archive/fca_export.md — Credential Formats context
% Pattern: negative elimination (same as prop_t/prop_s)

% predicate_proofs -> zkp (indistinguishable group, 100%)
% Formats without ZKP cannot provide predicate proofs.
% Eliminates SD-JWT-VC, JWT-VC, mdoc when predicate proofs needed.
propagation rule cap_predicate_not_sdjwt(Formatted_Credential f) <->
    must supports_predicate_proof(f),
    may SdJwtVcSchema(f)
==>
    !SdJwtVcSchema(f).

propagation rule cap_predicate_not_jwt(Formatted_Credential f) <->
    must supports_predicate_proof(f),
    may JwtVCCredentialSchema(f)
==>
    !JwtVCCredentialSchema(f).

propagation rule cap_predicate_not_mdoc(Formatted_Credential f) <->
    must supports_predicate_proof(f),
    may MdocSchema(f)
==>
    !MdocSchema(f).

propagation rule cap_predicate_not_jsonld(Formatted_Credential f) <->
    must supports_predicate_proof(f),
    may JsonLdCredentialSchema(f)
==>
    !JsonLdCredentialSchema(f).

% Offline/proximity verification: only mdoc satisfies this predicate.
% Eliminate all other formats when offline verification is required.
propagation rule cap_offline_not_jwt(Formatted_Credential f) <->
    must supports_offline_verification(f),
    may JwtVCCredentialSchema(f)
==>
    !JwtVCCredentialSchema(f).

propagation rule cap_offline_not_sdjwt(Formatted_Credential f) <->
    must supports_offline_verification(f),
    may SdJwtVcSchema(f)
==>
    !SdJwtVcSchema(f).

propagation rule cap_offline_not_anoncreds(Formatted_Credential f) <->
    must supports_offline_verification(f),
    may AnoncredsCredentialSchema(f)
==>
    !AnoncredsCredentialSchema(f).

propagation rule cap_offline_not_jsonld(Formatted_Credential f) <->
    must supports_offline_verification(f),
    may JsonLdCredentialSchema(f)
==>
    !JsonLdCredentialSchema(f).


% --- Governance annotation markers ---

abstract class GovernanceAnnotation {
}

% eIDAS 2.0 ARF: EU wallet attestations must use a mandated format
class EidasMandate extends GovernanceAnnotation {
    Credential[1] target
}

% GDPR Art. 5(1)(c): privacy-sensitive claims require data minimization
class PrivacyRequirement extends GovernanceAnnotation {
    Credential[1] target
}

% W3C VCDM 2.0: credential format must conform to the data model
class VcdmConformance extends GovernanceAnnotation {
    Credential[1] target
}


% --- Headline 2: Cross-credential predicate gap (shadow pred) ---
% Flags credential pairs with aligned subjects where at least one format
% lacks multi-credential proof support. Since no deployed format supports
% cross-credential arithmetic predicates, this flags all aligned pairs.

shadow pred cross_cred_predicate_gap(Credential c1, Credential c2) <->
    c1 != c2,
    credentialSubject(c1, cs1), credentialSubject(c2, cs2),
    aligned(cs1, cs2),
    format(c1, f1), !supports_multi_credential_proof(f1)
  ;
    c1 != c2,
    credentialSubject(c1, cs1), credentialSubject(c2, cs2),
    aligned(cs1, cs2),
    format(c2, f2), !supports_multi_credential_proof(f2).


% --- C4 x C9: the gapped pair a domain rule actually spans ---
% cross_cred_predicate_gap above fires for EVERY aligned pair, which is correct
% as a statement about format capability (no format has it, so no aligned pair
% can carry a cross-credential predicate) but says nothing about which pair the
% ecosystem needs one for. This predicate is that second, narrower fact: the
% pair is gapped AND a C4 domain rule reads a property realized in each of the
% two credentials. Direction is preserved: c1 carries the constrained property,
% c2 the property the rule reads.
%
% Read together, the two are the honest split of Headline 2: the capability is
% absent everywhere (C9), and the CSOK design needs it in exactly one place
% (this predicate). cross_cred_predicate_gap is NOT narrowed by C4 and its
% extension is unchanged.
shadow pred domain_dependency_gap(Credential c1, Credential c2) <->
    cross_cred_predicate_gap(c1, c2),
    credentialSubject(c1, cs1), credentialSubject(c2, cs2),
    Claim::source(k1, cs1), Claim::source(k2, cs2),
    Prop::trace(p1, k1), Prop::trace(p2, k2),
    depends_on(p1, p2).
