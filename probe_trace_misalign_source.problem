% ============================================================================
% Trace-misalignment probe — misaligned claim SOURCE (C2, prop_s)
% [D-029 evidence, 2026-08-03]
% ============================================================================
% Companion of probe_trace_misalign_target.problem for the second
% trace-consistency propagation rule, prop_s (vc_metamodel.refinery:162).
% Prop p_bc is owned by Entity b and its Claim cl_bc is asserted to have source
% cs_b, but cs_b is traced to a instead of b (the ONLY line changed from
% probe_trace_misalign_control.problem). prop_s therefore concludes
% !Claim::source(cl_bc, cs_b) against an asserted source.
% Expected result: UNSAT.

import vc_metamodel.

declare a, b, c, p_ab, p_bc.
declare cl_ab, cl_bc, cs_a, cs_b, cv_b, cv_c, Cred1, Cred2, f1, f2.

% === DCL: a -> b -> c (acyclic path) ===
Subject(a).
Value(b).
Value(c).
Prop(p_ab).
Prop(p_bc).
property(a, p_ab).
value(p_ab, b).
property(b, p_bc).
value(p_bc, c).

!exists(Subject::new).
!exists(Value::new).
!exists(Prop::new).

% === CSL: one claim per prop ===
Claim(cl_ab).
Claim(cl_bc).
CredentialSubject(cs_a).
CredentialSubject(cs_b).
CredentialValue(cv_b).
CredentialValue(cv_c).
Credential(Cred1).
Credential(Cred2).

Prop::trace(p_ab, cl_ab).
Prop::trace(p_bc, cl_bc).

Claim::source(cl_ab, cs_a).
Claim::target(cl_ab, cv_b).
Claim::source(cl_bc, cs_b).
Claim::target(cl_bc, cv_c).

_(cs_a, Cred1).
_(cs_b, Cred2).

CredEntity::trace(cs_a, a).
CredEntity::trace(cs_b, a).   % MISALIGNED: p_bc is a property of b, so cs_b must trace b
CredEntity::trace(cv_b, b).
CredEntity::trace(cv_c, c).

!exists(CredentialSubject::new).
!exists(CredentialValue::new).
!exists(Claim::new).
!exists(Credential::new).
default !CredEntity::trace(*, *).

% === FSL: fixed formats (no governance annotations imported) ===
SdJwtVcSchema(f1).
format(Cred1, f1).
SdJwtVcSchema(f2).
format(Cred2, f2).

!exists(AnoncredsCredentialSchema::new).
!exists(JsonLdCredentialSchema::new).
!exists(JwtVCCredentialSchema::new).
!exists(SdJwtVcSchema::new).
!exists(MdocSchema::new).

scope node = 15.
