@inproceedings{farkas_prolog-based_2024,
	title = {A {Prolog}-based {Approach} to {Self}-{Evaluated}, {Declarative} and {Zero}-{Knowledge} {Verifiable} {Policies}},
	issn = {2375-0227},
	url = {https://ieeexplore.ieee.org/document/10786564},
	doi = {10.1109/MASCOTS64422.2024.10786564},
	abstract = {In most domains where declarative policies are employed, it is typically the executor of the policy who performs policy evaluation, and not the subjects of policies. However, this approach has evident drawbacks from the trust, transparency and privacy aspects, especially when the subjects are natural persons. Building on recent developments in noninteractive zero-knowledge proofs and the technologies and standards supporting Self-Sovereign Indentity solutions, in this paper, we propose Self-Evaluated Policies, which move policy evaluation to the subject and leave the executor in a (zero-knowledge) proof-checking role. We present an SSI-based system model, propose a proof-tree-checking computational model for zero-knowledge proofs over the evaluations of Prolog-based policies, and describe a Circombased prototype.},
	urldate = {2025-11-02},
	booktitle = {2024 32nd {International} {Conference} on {Modeling}, {Analysis} and {Simulation} of {Computer} and {Telecommunication} {Systems} ({MASCOTS})},
	author = {Farkas, Martin and Toldi, Balaźs Ádám and Péter, Bertalan Zoltán and Kocsis, Imre},
	month = oct,
	year = {2024},
	keywords = {Analytical models, Buildings, Computational modeling, Privacy, Prototypes, Standards, Telecommunications, declarative policies, meta-programming, verifiable credentials, zero-knowledge proofs},
	pages = {1--6},
}

@inproceedings{yang_batchman_2023,
	address = {New York, NY, USA},
	series = {{CCS} '23},
	title = {Batchman and {Robin}: {Batched} and {Non}-batched {Branching} for {Interactive} {ZK}},
	isbn = {979-8-4007-0050-7},
	shorttitle = {Batchman and {Robin}},
	url = {https://dl.acm.org/doi/10.1145/3576915.3623169},
	doi = {10.1145/3576915.3623169},
	abstract = {Vector Oblivious Linear Evaluation (VOLE) supports fast and scalable interactive Zero-Knowledge (ZK) proofs. Despite recent improvements to VOLE-based ZK, compiling proof statements to a control-flow oblivious form (e.g., a circuit) continues to lead to expensive proofs. One useful setting where this inefficiency stands out is when the statement is a disjunction of clauses {\textbackslash}mathcalL \_1 łor {\textbackslash}cdots łor {\textbackslash}mathcalL \_B. Typically, ZK requires paying the price to handle all B branches. Prior works have shown how to avoid this price in communication, but not in computation.  Our main result, {\textbackslash}mathsfBatchman , is asymptotically and concretely efficient VOLE-based ZK for batched disjunctions, i.e. statements containing R repetitions of the same disjunction. This is crucial for, e.g., emulating CPU steps in ZK. Our prover and verifier complexity is only {\textbackslash}bigO(RB+R{\textbar}{\textbackslash}C{\textbar}+B{\textbar}{\textbackslash}C{\textbar}), where {\textbar}{\textbackslash}C{\textbar} is the maximum circuit size of the B branches. Prior works' computation scales in RB{\textbar}{\textbackslash}C{\textbar}. For non-batched disjunctions, we also construct a VOLE-based ZK protocol, {\textbackslash}mathsfRobin , which is (only) communication efficient. For small fields and for statistical security parameter łambda, this protocol's communication improves over the previous state of the art ({\textbackslash}mathsfMac'n'Cheese , Baum et al., CRYPTO'21) by up to factor łambda.  Our implementation outperforms prior state of the art. E.g., we achieve up to 6× improvement over {\textbackslash}mathsfMac'n'Cheese (Boolean, single disjunction), and for arithmetic batched disjunctions our experiments show we improve over {\textbackslash}mathsfQuickSilver (Yang et al., CCS'21) by up to 70× and over {\textbackslash}mathsfAntMan (Weng et al., CCS'22) by up to 36×.},
	urldate = {2025-11-02},
	booktitle = {Proceedings of the 2023 {ACM} {SIGSAC} {Conference} on {Computer} and {Communications} {Security}},
	publisher = {Association for Computing Machinery},
	author = {Yang, Yibin and Heath, David and Hazay, Carmit and Kolesnikov, Vladimir and Venkitasubramaniam, Muthuramakrishnan},
	month = nov,
	year = {2023},
	pages = {1452--1466},
}

