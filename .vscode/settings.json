{
    // === Environment ===
    "terminal.integrated.env.windows": {
        "PATH": "${env:PATH};${env:LOCALAPPDATA}\\Pandoc;${env:LOCALAPPDATA}\\Programs\\MiKTeX\\miktex\\bin\\x64"
    },
    // === LaTeX Workshop ===
    "latex-workshop.latex.rootFile": "pandoc/main.tex",
    // Custom tools
    "latex-workshop.latex.tools": [
        {
            "name": "pandoc-build",
            "command": "bash",
            "args": [
                "build.sh",
                "draft"
            ],
            "env": {
                "PATH": "${env:PATH};${env:LOCALAPPDATA}\\Pandoc;${env:LOCALAPPDATA}\\Programs\\MiKTeX\\miktex\\bin\\x64"
            }
        },
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-synctex=1",
                "-interaction=nonstopmode",
                "pandoc/main.tex"
            ],
            "env": {
                "PATH": "${env:PATH};${env:LOCALAPPDATA}\\Programs\\MiKTeX\\miktex\\bin\\x64"
            }
        }
    ],
    // Recipes — pandoc first, then latexmk
    "latex-workshop.latex.recipes": [
        {
            "name": "pandoc + latexmk",
            "tools": [
                "pandoc-build",
                "latexmk"
            ]
        },
        {
            "name": "latexmk only",
            "tools": [
                "latexmk"
            ]
        }
    ],
    // PDF viewer — use VS Code tab
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.outDir": "build",
    // Auto-build on .tex save — .md→.tex handled by watch task
    "latex-workshop.latex.autoBuild.run": "onSave",
    // === Editor Associations ===
    "workbench.editorAssociations": {
        "*.md": "inkdown.editor",
        "*.copilotmd": "vscode.markdown.preview.editor",
        "{hexdiff}:/**/*.*": "hexEditor.hexedit",
        "*.caff": "default"
    }
}