% ============================================================================
% Headline 1: Governance conflict error predicate
% ============================================================================
% Fires when a credential has both eIDAS mandate and privacy requirement,
% but no single format satisfies both.
% Clause 1: VCDM-conformant formats lack predicate proofs.
% Clause 2: Predicate-proof formats lack VCDM conformance.
% Since the two sets are disjoint, every format triggers one clause -> UNSAT.

import vc_metamodel.

error governance_conflict(Credential c, Formatted_Credential f) <->
    EidasMandate::target(_, c),
    PrivacyRequirement::target(_, c),
    format(c, f),
    conforms_vcdm(f),
    !supports_predicate_proof(f)
  ;
    EidasMandate::target(_, c),
    PrivacyRequirement::target(_, c),
    format(c, f),
    supports_predicate_proof(f),
    !conforms_vcdm(f).
