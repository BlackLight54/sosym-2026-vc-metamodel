import vc_metamodel.


% === DCL: domain facts ===

declare Applicant.
declare prop_1, prop_2, prop_3, prop_4, prop_5.
declare val_1, val_2, val_3, val_4, val_5.

Subject(Applicant).
Prop(prop_1).
Prop(prop_2).
Prop(prop_3).
Prop(prop_4).
Prop(prop_5).
Value(val_1).
Value(val_2).
Value(val_3).
Value(val_4).
Value(val_5).

property(Applicant, prop_1).
property(Applicant, prop_2).
property(Applicant, prop_3).
property(Applicant, prop_4).
property(Applicant, prop_5).
value(prop_1, val_1).
value(prop_2, val_2).
value(prop_3, val_3).
value(prop_4, val_4).
value(prop_5, val_5).

% Close DCL
!exists(Subject::new).
!exists(Value::new).
!exists(Prop::new).


% === CSL: credential decomposition ===

declare cs_1, cs_2, cs_3, cs_4, cs_5.
declare claim_1, claim_2, claim_3, claim_4, claim_5.
declare cv_1, cv_2, cv_3, cv_4, cv_5.
declare cred_1, cred_2, cred_3, cred_4, cred_5.

CredentialSubject(cs_1).
CredentialSubject(cs_2).
CredentialSubject(cs_3).
CredentialSubject(cs_4).
CredentialSubject(cs_5).
Claim(claim_1).
Claim(claim_2).
Claim(claim_3).
Claim(claim_4).
Claim(claim_5).
CredentialValue(cv_1).
CredentialValue(cv_2).
CredentialValue(cv_3).
CredentialValue(cv_4).
CredentialValue(cv_5).
Credential(cred_1).
Credential(cred_2).
Credential(cred_3).
Credential(cred_4).
Credential(cred_5).

% Trace: Prop -> Claim
Prop::trace(prop_1, claim_1).
Prop::trace(prop_2, claim_2).
Prop::trace(prop_3, claim_3).
Prop::trace(prop_4, claim_4).
Prop::trace(prop_5, claim_5).

% Claims: source and target
Claim::source(claim_1, cs_1).
Claim::target(claim_1, cv_1).
Claim::source(claim_2, cs_2).
Claim::target(claim_2, cv_2).
Claim::source(claim_3, cs_3).
Claim::target(claim_3, cv_3).
Claim::source(claim_4, cs_4).
Claim::target(claim_4, cv_4).
Claim::source(claim_5, cs_5).
Claim::target(claim_5, cv_5).

% Credential containment
_(cs_1, cred_1).
_(cs_2, cred_2).
_(cs_3, cred_3).
_(cs_4, cred_4).
_(cs_5, cred_5).

% Entity alignment: all credential subjects trace to Applicant
CredEntity::trace(cs_1, Applicant).
CredEntity::trace(cs_2, Applicant).
CredEntity::trace(cs_3, Applicant).
CredEntity::trace(cs_4, Applicant).
CredEntity::trace(cs_5, Applicant).

% Value traces
CredEntity::trace(cv_1, val_1).
CredEntity::trace(cv_2, val_2).
CredEntity::trace(cv_3, val_3).
CredEntity::trace(cv_4, val_4).
CredEntity::trace(cv_5, val_5).

% Close CSL
!exists(CredentialSubject::new).
!exists(CredentialValue::new).
!exists(Claim::new).
!exists(Credential::new).
default !CredEntity::trace(*, *).


% === FSL: format assignments ===

declare fmt_1, fmt_2, fmt_3, fmt_4, fmt_5.

SdJwtVcSchema(fmt_1).
format(cred_1, fmt_1).
SdJwtVcSchema(fmt_2).
format(cred_2, fmt_2).
SdJwtVcSchema(fmt_3).
format(cred_3, fmt_3).
SdJwtVcSchema(fmt_4).
format(cred_4, fmt_4).

% cred_5: format class left open for solver
Formatted_Credential(fmt_5).
format(cred_5, fmt_5).

% Close FSL
!exists(AnoncredsCredentialSchema::new).
!exists(JsonLdCredentialSchema::new).
!exists(JwtVCCredentialSchema::new).
!exists(SdJwtVcSchema::new).
!exists(MdocSchema::new).


% === Governance markers ===

EidasMandate(eidas_1).
EidasMandate::target(eidas_1, cred_1).
EidasMandate(eidas_2).
EidasMandate::target(eidas_2, cred_2).
EidasMandate(eidas_3).
EidasMandate::target(eidas_3, cred_3).
EidasMandate(eidas_4).
EidasMandate::target(eidas_4, cred_4).
EidasMandate(eidas_5).
