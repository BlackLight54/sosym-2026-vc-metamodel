% ========================================================================
% Instance: E3_G6 — N=3 credentials, variant=sat
% Governance: privacy, vcdm
% Total nodes: 26, GovernanceAnnotation: 4
% ========================================================================

import vc_metamodel.
import governance_conflict.


% === DCL: domain facts ===

declare Applicant.
declare prop_1, prop_2, prop_3.
declare val_1, val_2, val_3.

Subject(Applicant).
Prop(prop_1).
Prop(prop_2).
Prop(prop_3).
Value(val_1).
Value(val_2).
Value(val_3).

property(Applicant, prop_1).
property(Applicant, prop_2).
property(Applicant, prop_3).
value(prop_1, val_1).
value(prop_2, val_2).
value(prop_3, val_3).

% Close DCL
!exists(Subject::new).
!exists(Value::new).
!exists(Prop::new).


% === CSL: credential decomposition ===

declare cs_1, cs_2, cs_3.
declare claim_1, claim_2, claim_3.
declare cv_1, cv_2, cv_3.
declare cred_1, cred_2, cred_3.

CredentialSubject(cs_1).
CredentialSubject(cs_2).
CredentialSubject(cs_3).
Claim(claim_1).
Claim(claim_2).
Claim(claim_3).
CredentialValue(cv_1).
CredentialValue(cv_2).
CredentialValue(cv_3).
Credential(cred_1).
Credential(cred_2).
Credential(cred_3).

% Trace: Prop -> Claim
Prop::trace(prop_1, claim_1).
Prop::trace(prop_2, claim_2).
Prop::trace(prop_3, claim_3).

% Claims: source and target
Claim::source(claim_1, cs_1).
Claim::target(claim_1, cv_1).
Claim::source(claim_2, cs_2).
Claim::target(claim_2, cv_2).
Claim::source(claim_3, cs_3).
Claim::target(claim_3, cv_3).

% Credential containment
_(cs_1, cred_1).
_(cs_2, cred_2).
_(cs_3, cred_3).

% Entity alignment: all credential subjects trace to Applicant
CredEntity::trace(cs_1, Applicant).
CredEntity::trace(cs_2, Applicant).
CredEntity::trace(cs_3, Applicant).

% Value traces
CredEntity::trace(cv_1, val_1).
CredEntity::trace(cv_2, val_2).
CredEntity::trace(cv_3, val_3).

% Close CSL
!exists(CredentialSubject::new).
!exists(CredentialValue::new).
!exists(Claim::new).
!exists(Credential::new).
default !CredEntity::trace(*, *).


% === FSL: format assignments ===

declare fmt_1, fmt_2, fmt_3.

SdJwtVcSchema(fmt_1).
format(cred_1, fmt_1).
SdJwtVcSchema(fmt_2).
format(cred_2, fmt_2).

% cred_3: format class left open for solver
Formatted_Credential(fmt_3).
format(cred_3, fmt_3).

% Close FSL
!exists(AnoncredsCredentialSchema::new).
!exists(JsonLdCredentialSchema::new).
!exists(JwtVCCredentialSchema::new).
!exists(SdJwtVcSchema::new).
!exists(MdocSchema::new).


% === Governance markers ===

PrivacyRequirement(privacy_1).
PrivacyRequirement::target(privacy_1, cred_3).

VcdmConformance(vcdm_1).
VcdmConformance::target(vcdm_1, cred_1).
VcdmConformance(vcdm_2).
VcdmConformance::target(vcdm_2, cred_2).
VcdmConformance(vcdm_3).
VcdmConformance::target(vcdm_3, cred_3).

% Close governance
!exists(EidasMandate::new).
!exists(PrivacyRequirement::new).
!exists(VcdmConformance::new).


scope node = 26, GovernanceAnnotation = 4.
