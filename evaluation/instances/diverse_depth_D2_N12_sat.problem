Value(dv_1_0).
Value(dv_1_1).
Value(dv_2_0).
Value(dv_2_1).
Value(dv_3_0).
Value(dv_3_1).
Value(dv_4_0).
Value(dv_4_1).
Value(dv_5_0).
Value(dv_5_1).

property(Applicant, dp_0_0).
property(dv_0_0, dp_0_1).
property(Applicant, dp_1_0).
property(dv_1_0, dp_1_1).
property(Applicant, dp_2_0).
property(dv_2_0, dp_2_1).
property(Applicant, dp_3_0).
property(dv_3_0, dp_3_1).
property(Applicant, dp_4_0).
property(dv_4_0, dp_4_1).
property(Applicant, dp_5_0).
property(dv_5_0, dp_5_1).
value(dp_0_0, dv_0_0).
value(dp_0_1, dv_0_1).
value(dp_1_0, dv_1_0).
value(dp_1_1, dv_1_1).
value(dp_2_0, dv_2_0).
value(dp_2_1, dv_2_1).
value(dp_3_0, dv_3_0).
value(dp_3_1, dv_3_1).
value(dp_4_0, dv_4_0).
value(dp_4_1, dv_4_1).
value(dp_5_0, dv_5_0).
value(dp_5_1, dv_5_1).

% Close DCL
!exists(Subject::new).
!exists(Value::new).
!exists(Prop::new).


% === CSL: credential decomposition (chained) ===

declare cs_0_0, claim_0_0, cv_0_0, cred_0_0.
declare cs_0_1, claim_0_1, cv_0_1, cred_0_1.
declare cs_1_0, claim_1_0, cv_1_0, cred_1_0.
declare cs_1_1, claim_1_1, cv_1_1, cred_1_1.
declare cs_2_0, claim_2_0, cv_2_0, cred_2_0.
declare cs_2_1, claim_2_1, cv_2_1, cred_2_1.
declare cs_3_0, claim_3_0, cv_3_0, cred_3_0.
declare cs_3_1, claim_3_1, cv_3_1, cred_3_1.
declare cs_4_0, claim_4_0, cv_4_0, cred_4_0.
declare cs_4_1, claim_4_1, cv_4_1, cred_4_1.
declare cs_5_0, claim_5_0, cv_5_0, cred_5_0.
declare cs_5_1, claim_5_1, cv_5_1, cred_5_1.

CredentialSubject(cs_0_0).
CredentialSubject(cs_0_1).
CredentialSubject(cs_1_0).
CredentialSubject(cs_1_1).
CredentialSubject(cs_2_0).
CredentialSubject(cs_2_1).
CredentialSubject(cs_3_0).
CredentialSubject(cs_3_1).
CredentialSubject(cs_4_0).
CredentialSubject(cs_4_1).
CredentialSubject(cs_5_0).
CredentialSubject(cs_5_1).
Claim(claim_0_0).
Claim(claim_0_1).
Claim(claim_1_0).
Claim(claim_1_1).
Claim(claim_2_0).
Claim(claim_2_1).
Claim(claim_3_0).
Claim(claim_3_1).
Claim(claim_4_0).
Claim(claim_4_1).
Claim(claim_5_0).
Claim(claim_5_1).
CredentialValue(cv_0_0).
CredentialValue(cv_0_1).
CredentialValue(cv_1_0).
CredentialValue(cv_1_1).
CredentialValue(cv_2_0).
CredentialValue(cv_2_1).
CredentialValue(cv_3_0).
CredentialValue(cv_3_1).
CredentialValue(cv_4_0).
CredentialValue(cv_4_1).
CredentialValue(cv_5_0).
CredentialValue(cv_5_1).
Credential(cred_0_0).
Credential(cred_0_1).
Credential(cred_1_0).
Credential(cred_1_1).
Credential(cred_2_0).
Credential(cred_2_1).
Credential(cred_3_0).
Credential(cred_3_1).
Credential(cred_4_0).
Credential(cred_4_1).
Credential(cred_5_0).
Credential(cred_5_1).

% Trace: Prop -> Claim
Prop::trace(dp_0_0, claim_0_0).
Prop::trace(dp_0_1, claim_0_1).
Prop::trace(dp_1_0, claim_1_0).
Prop::trace(dp_1_1, claim_1_1).
Prop::trace(dp_2_0, claim_2_0).
Prop::trace(dp_2_1, claim_2_1).
Prop::trace(dp_3_0, claim_3_0).
Prop::trace(dp_3_1, claim_3_1).
Prop::trace(dp_4_0, claim_4_0).
Prop::trace(dp_4_1, claim_4_1).
Prop::trace(dp_5_0, claim_5_0).
Prop::trace(dp_5_1, claim_5_1).

% Claims: source (subject) and target (value)
Claim::source(claim_0_0, cs_0_0).
Claim::target(claim_0_0, cv_0_0).
Claim::source(claim_0_1, cs_0_1).
Claim::target(claim_0_1, cv_0_1).
Claim::source(claim_1_0, cs_1_0).
Claim::target(claim_1_0, cv_1_0).
Claim::source(claim_1_1, cs_1_1).
Claim::target(claim_1_1, cv_1_1).
Claim::source(claim_2_0, cs_2_0).
Claim::target(claim_2_0, cv_2_0).
Claim::source(claim_2_1, cs_2_1).
Claim::target(claim_2_1, cv_2_1).
Claim::source(claim_3_0, cs_3_0).
Claim::target(claim_3_0, cv_3_0).
Claim::source(claim_3_1, cs_3_1).
Claim::target(claim_3_1, cv_3_1).
Claim::source(claim_4_0, cs_4_0).
Claim::target(claim_4_0, cv_4_0).
Claim::source(claim_4_1, cs_4_1).
Claim::target(claim_4_1, cv_4_1).
Claim::source(claim_5_0, cs_5_0).
Claim::target(claim_5_0, cv_5_0).
Claim::source(claim_5_1, cs_5_1).
Claim::target(claim_5_1, cv_5_1).

% Credential containment
_(cs_0_0, cred_0_0).
_(cs_0_1, cred_0_1).
_(cs_1_0, cred_1_0).
_(cs_1_1, cred_1_1).
_(cs_2_0, cred_2_0).
_(cs_2_1, cred_2_1).
_(cs_3_0, cred_3_0).
_(cs_3_1, cred_3_1).
_(cs_4_0, cred_4_0).
_(cs_4_1, cred_4_1).
_(cs_5_0, cred_5_0).
_(cs_5_1, cred_5_1).

% Entity alignment: subject traces to its domain anchor,
% value traces to its domain value. A child credential's subject and its
% parent credential's value trace the SAME domain entity (multi-subject).
CredEntity::trace(cs_0_0, Applicant).
CredEntity::trace(cs_0_1, dv_0_0).
CredEntity::trace(cs_1_0, Applicant).
CredEntity::trace(cs_1_1, dv_1_0).
CredEntity::trace(cs_2_0, Applicant).
CredEntity::trace(cs_2_1, dv_2_0).
CredEntity::trace(cs_3_0, Applicant).
CredEntity::trace(cs_3_1, dv_3_0).
CredEntity::trace(cs_4_0, Applicant).
CredEntity::trace(cs_4_1, dv_4_0).
CredEntity::trace(cs_5_0, Applicant).
CredEntity::trace(cs_5_1, dv_5_0).
CredEntity::trace(cv_0_0, dv_0_0).
CredEntity::trace(cv_0_1, dv_0_1).
CredEntity::trace(cv_1_0, dv_1_0).
CredEntity::trace(cv_1_1, dv_1_1).
CredEntity::trace(cv_2_0, dv_2_0).
CredEntity::trace(cv_2_1, dv_2_1).
CredEntity::trace(cv_3_0, dv_3_0).
CredEntity::trace(cv_3_1, dv_3_1).
CredEntity::trace(cv_4_0, dv_4_0).
CredEntity::trace(cv_4_1, dv_4_1).
CredEntity::trace(cv_5_0, dv_5_0).
CredEntity::trace(cv_5_1, dv_5_1).

% Close CSL
!exists(CredentialSubject::new).
!exists(CredentialValue::new).
!exists(Claim::new).
!exists(Credential::new).
default !CredEntity::trace(*, *).


% === FSL: format assignments ===

declare fmt_0_0, fmt_0_1, fmt_1_0, fmt_1_1, fmt_2_0, fmt_2_1, fmt_3_0, fmt_3_1, fmt_4_0, fmt_4_1, fmt_5_0, fmt_5_1.

SdJwtVcSchema(fmt_0_0).
format(cred_0_0, fmt_0_0).
SdJwtVcSchema(fmt_0_1).
format(cred_0_1, fmt_0_1).
SdJwtVcSchema(fmt_1_0).
format(cred_1_0, fmt_1_0).
SdJwtVcSchema(fmt_1_1).
format(cred_1_1, fmt_1_1).
SdJwtVcSchema(fmt_2_0).
format(cred_2_0, fmt_2_0).
SdJwtVcSchema(fmt_2_1).
format(cred_2_1, fmt_2_1).
SdJwtVcSchema(fmt_3_0).
