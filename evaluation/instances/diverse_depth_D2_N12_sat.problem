% ========================================================================
% Instance: ED_depth_D2_N12 — N=12 credentials, depth=2, breadth=6, subjects=7, variant=sat
% Governance: eidas, privacy, vcdm
% Structure: chained credentials (a credential can describe the value of its parent credential)
% ========================================================================

import vc_metamodel.


% === DCL: domain facts (chained) ===

declare Applicant.
declare dp_0_0, dv_0_0.
declare dp_0_1, dv_0_1.
declare dp_1_0, dv_1_0.
declare dp_1_1, dv_1_1.
declare dp_2_0, dv_2_0.
declare dp_2_1, dv_2_1.
declare dp_3_0, dv_3_0.
declare dp_3_1, dv_3_1.
declare dp_4_0, dv_4_0.
declare dp_4_1, dv_4_1.
declare dp_5_0, dv_5_0.
declare dp_5_1, dv_5_1.

Subject(Applicant).
Prop(dp_0_0).
Prop(dp_0_1).
Prop(dp_1_0).
Prop(dp_1_1).
Prop(dp_2_0).
Prop(dp_2_1).
Prop(dp_3_0).
Prop(dp_3_1).
Prop(dp_4_0).
Prop(dp_4_1).
Prop(dp_5_0).
Prop(dp_5_1).
Value(dv_0_0).
