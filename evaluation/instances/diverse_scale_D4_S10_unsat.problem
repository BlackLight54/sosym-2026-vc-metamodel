declare dp_1_2, dv_1_2.
declare dp_2_0, dv_2_0.
declare dp_2_1, dv_2_1.
declare dp_2_2, dv_2_2.

Subject(Applicant).
Prop(dp_0_0).
Prop(dp_0_1).
Prop(dp_0_2).
Prop(dp_0_3).
Prop(dp_1_0).
Prop(dp_1_1).
Prop(dp_1_2).
Prop(dp_2_0).
Prop(dp_2_1).
Prop(dp_2_2).
