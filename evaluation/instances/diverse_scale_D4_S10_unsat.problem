property(dv_0_0, dp_0_1).
property(dv_0_1, dp_0_2).
property(dv_0_2, dp_0_3).
property(Applicant, dp_1_0).
property(dv_1_0, dp_1_1).
property(dv_1_1, dp_1_2).
property(Applicant, dp_2_0).
property(dv_2_0, dp_2_1).
property(dv_2_1, dp_2_2).
value(dp_0_0, dv_0_0).
value(dp_0_1, dv_0_1).
value(dp_0_2, dv_0_2).
value(dp_0_3, dv_0_3).
value(dp_1_0, dv_1_0).
value(dp_1_1, dv_1_1).
value(dp_1_2, dv_1_2).
value(dp_2_0, dv_2_0).
value(dp_2_1, dv_2_1).
value(dp_2_2, dv_2_2).

% Close DCL
!exists(Subject::new).
!exists(Value::new).
!exists(Prop::new).


% === CSL: credential decomposition (chained) ===

declare cs_0_0, claim_0_0, cv_0_0, cred_0_0.
declare cs_0_1, claim_0_1, cv_0_1, cred_0_1.
declare cs_0_2, claim_0_2, cv_0_2, cred_0_2.
declare cs_0_3, claim_0_3, cv_0_3, cred_0_3.
declare cs_1_0, claim_1_0, cv_1_0, cred_1_0.
declare cs_1_1, claim_1_1, cv_1_1, cred_1_1.
declare cs_1_2, claim_1_2, cv_1_2, cred_1_2.
declare cs_2_0, claim_2_0, cv_2_0, cred_2_0.
declare cs_2_1, claim_2_1, cv_2_1, cred_2_1.
declare cs_2_2, claim_2_2, cv_2_2, cred_2_2.

CredentialSubject(cs_0_0).
CredentialSubject(cs_0_1).
CredentialSubject(cs_0_2).
CredentialSubject(cs_0_3).
CredentialSubject(cs_1_0).
CredentialSubject(cs_1_1).
CredentialSubject(cs_1_2).
CredentialSubject(cs_2_0).
CredentialSubject(cs_2_1).
CredentialSubject(cs_2_2).
Claim(claim_0_0).
Claim(claim_0_1).
Claim(claim_0_2).
Claim(claim_0_3).
Claim(claim_1_0).
Claim(claim_1_1).
Claim(claim_1_2).
Claim(claim_2_0).
Claim(claim_2_1).
Claim(claim_2_2).
CredentialValue(cv_0_0).
CredentialValue(cv_0_1).
CredentialValue(cv_0_2).
CredentialValue(cv_0_3).
CredentialValue(cv_1_0).
CredentialValue(cv_1_1).
CredentialValue(cv_1_2).
CredentialValue(cv_2_0).
CredentialValue(cv_2_1).
CredentialValue(cv_2_2).
Credential(cred_0_0).
Credential(cred_0_1).
Credential(cred_0_2).
Credential(cred_0_3).
Credential(cred_1_0).
Credential(cred_1_1).
Credential(cred_1_2).
Credential(cred_2_0).
Credential(cred_2_1).
Credential(cred_2_2).

% Trace: Prop -> Claim
Prop::trace(dp_0_0, claim_0_0).
Prop::trace(dp_0_1, claim_0_1).
Prop::trace(dp_0_2, claim_0_2).
Prop::trace(dp_0_3, claim_0_3).
Prop::trace(dp_1_0, claim_1_0).
Prop::trace(dp_1_1, claim_1_1).
Prop::trace(dp_1_2, claim_1_2).
Prop::trace(dp_2_0, claim_2_0).
Prop::trace(dp_2_1, claim_2_1).
Prop::trace(dp_2_2, claim_2_2).

% Claims: source (subject) and target (value)
Claim::source(claim_0_0, cs_0_0).
Claim::target(claim_0_0, cv_0_0).
Claim::source(claim_0_1, cs_0_1).
Claim::target(claim_0_1, cv_0_1).
Claim::source(claim_0_2, cs_0_2).
Claim::target(claim_0_2, cv_0_2).
Claim::source(claim_0_3, cs_0_3).
Claim::target(claim_0_3, cv_0_3).
Claim::source(claim_1_0, cs_1_0).
Claim::target(claim_1_0, cv_1_0).
Claim::source(claim_1_1, cs_1_1).
Claim::target(claim_1_1, cv_1_1).
Claim::source(claim_1_2, cs_1_2).
Claim::target(claim_1_2, cv_1_2).
Claim::source(claim_2_0, cs_2_0).
Claim::target(claim_2_0, cv_2_0).
Claim::source(claim_2_1, cs_2_1).
Claim::target(claim_2_1, cv_2_1).
Claim::source(claim_2_2, cs_2_2).
Claim::target(claim_2_2, cv_2_2).

% Credential containment
_(cs_0_0, cred_0_0).
_(cs_0_1, cred_0_1).
_(cs_0_2, cred_0_2).
_(cs_0_3, cred_0_3).
_(cs_1_0, cred_1_0).
_(cs_1_1, cred_1_1).
_(cs_1_2, cred_1_2).
_(cs_2_0, cred_2_0).
_(cs_2_1, cred_2_1).
_(cs_2_2, cred_2_2).

% Entity alignment: subject traces to its domain anchor,
% value traces to its domain value. A child credential's subject and its
% parent credential's value trace the SAME domain entity (multi-subject).
CredEntity::trace(cs_0_0, Applicant).
CredEntity::trace(cs_0_1, dv_0_0).
CredEntity::trace(cs_0_2, dv_0_1).
CredEntity::trace(cs_0_3, dv_0_2).
CredEntity::trace(cs_1_0, Applicant).
CredEntity::trace(cs_1_1, dv_1_0).
CredEntity::trace(cs_1_2, dv_1_1).
CredEntity::trace(cs_2_0, Applicant).
CredEntity::trace(cs_2_1, dv_2_0).
CredEntity::trace(cs_2_2, dv_2_1).
CredEntity::trace(cv_0_0, dv_0_0).
CredEntity::trace(cv_0_1, dv_0_1).
CredEntity::trace(cv_0_2, dv_0_2).
CredEntity::trace(cv_0_3, dv_0_3).
CredEntity::trace(cv_1_0, dv_1_0).
CredEntity::trace(cv_1_1, dv_1_1).
CredEntity::trace(cv_1_2, dv_1_2).
CredEntity::trace(cv_2_0, dv_2_0).
CredEntity::trace(cv_2_1, dv_2_1).
CredEntity::trace(cv_2_2, dv_2_2).

% Close CSL
!exists(CredentialSubject::new).
!exists(CredentialValue::new).
!exists(Claim::new).
!exists(Credential::new).
default !CredEntity::trace(*, *).


% === FSL: format assignments ===

declare fmt_0_0, fmt_0_1, fmt_0_2, fmt_0_3, fmt_1_0, fmt_1_1, fmt_1_2, fmt_2_0, fmt_2_1, fmt_2_2.

