% ============================================================================
% Trace-misalignment probe — misaligned claim TARGET (C1, prop_t)
% [DEC-overpromise_until_delivered evidence, 2026-08-03]
% ============================================================================
% The issuance/schema-binding class (vault CPT-design_error_issuance_schema_binding) is enforced by the two
% cross-layer trace-consistency propagation rules prop_t (vc_metamodel.refinery:153)
% and prop_s (vc_metamodel.refinery:162). Propagation rules remove `may` edges
% rather than raising error atoms, so no delivered instance recorded them
% firing; the DEC-overpromise_until_delivered register carried a true-positive instance for this class as
% an open obligation.
% This probe forces the rule into a contradiction so the firing is observable:
% Prop p_ab relates a -> b, its Claim cl_ab is asserted to target cv_b, but
% cv_b is traced to c instead of b (the ONLY line changed from
% probe_trace_misalign_control.problem). prop_t therefore concludes
% !Claim::target(cl_ab, cv_b) against an asserted target.
% prop_s cannot account for the rejection: every claim source (cs_a -> a,
% cs_b -> b) stays aligned with the Prop's owning Entity.
% Expected result: UNSAT.

import vc_metamodel.

declare a, b, c, p_ab, p_bc.
declare cl_ab, cl_bc, cs_a, cs_b, cv_b, cv_c, Cred1, Cred2, f1, f2.

% === DCL: a -> b -> c (acyclic path) ===
Subject(a).
Value(b).
Value(c).
Prop(p_ab).
Prop(p_bc).
property(a, p_ab).
value(p_ab, b).
property(b, p_bc).
value(p_bc, c).

!exists(Subject::new).
!exists(Value::new).
!exists(Prop::new).

% === CSL: one claim per prop ===
Claim(cl_ab).
Claim(cl_bc).
CredentialSubject(cs_a).
CredentialSubject(cs_b).
CredentialValue(cv_b).
CredentialValue(cv_c).
Credential(Cred1).
Credential(Cred2).

Prop::trace(p_ab, cl_ab).
Prop::trace(p_bc, cl_bc).

Claim::source(cl_ab, cs_a).
Claim::target(cl_ab, cv_b).
Claim::source(cl_bc, cs_b).
Claim::target(cl_bc, cv_c).

_(cs_a, Cred1).
_(cs_b, Cred2).

CredEntity::trace(cs_a, a).
CredEntity::trace(cs_b, b).
CredEntity::trace(cv_b, c).   % MISALIGNED: p_ab relates a -> b, so cv_b must trace b
CredEntity::trace(cv_c, c).

!exists(CredentialSubject::new).
!exists(CredentialValue::new).
!exists(Claim::new).
!exists(Credential::new).
default !CredEntity::trace(*, *).

% === FSL: fixed formats (no governance annotations imported) ===
SdJwtVcSchema(f1).
format(Cred1, f1).
SdJwtVcSchema(f2).
format(Cred2, f2).

!exists(AnoncredsCredentialSchema::new).
!exists(JsonLdCredentialSchema::new).
!exists(JwtVCCredentialSchema::new).
!exists(SdJwtVcSchema::new).
!exists(MdocSchema::new).

scope node = 15.
